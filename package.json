{
  "name": "jettortoise",
  "displayName": "JetTortoise",
  "publisher": "jieyuexing",
  "description": "IDEA-style Commit and Log for Git and CVS across workspace repositories.",
  "version": "0.6.0",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jieyuexing/vscode-jettortoise-plugin"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "intellij",
    "jetbrains",
    "idea",
    "git graph",
    "commit",
    "shelf",
    "stash",
    "branch",
    "merge",
    "cherry-pick",
    "rebase",
    "git log",
    "context menu",
    "diff",
    "3-way merge",
    "webstorm",
    "pycharm",
    "goland",
    "rider"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "jettortoise.panel",
          "title": "JetTortoise",
          "icon": "$(git-branch)"
        }
      ],
      "activitybar": [
        {
          "id": "jettortoise.commit",
          "title": "Commit",
          "icon": "images/commit-icon.svg"
        }
      ]
    },
    "views": {
      "jettortoise.panel": [
        {
          "type": "webview",
          "id": "jettortoise.gitLog",
          "name": "Log"
        }
      ],
      "jettortoise.commit": [
        {
          "type": "webview",
          "id": "jettortoise.commitPanel",
          "name": "Commit"
        }
      ]
    },
    "commands": [
      {
        "command": "jettortoise.refreshLog",
        "title": "Refresh Log",
        "icon": "$(refresh)",
        "category": "JetTortoise"
      },
      {
        "command": "jettortoise.openMergeEditor",
        "title": "Open Merge Editor",
        "category": "JetTortoise"
      },
      {
        "command": "jettortoise.openConflicts",
        "title": "Conflicts",
        "icon": "$(git-merge)",
        "category": "JetTortoise"
      },
      {
        "command": "jettortoise.openMergeEditorFromSCM",
        "title": "Open in JetTortoise Merge Editor",
        "icon": "$(git-merge)",
        "category": "JetTortoise"
      },
      {
        "command": "jettortoise.showFileHistory",
        "title": "(JetTortoise) Show File History",
        "icon": "$(history)",
        "category": "JetTortoise"
      },
      {
        "command": "jettortoise.nextDiff",
        "title": "Next File Diff",
        "icon": "$(arrow-down)",
        "category": "JetTortoise"
      },
      {
        "command": "jettortoise.prevDiff",
        "title": "Previous File Diff",
        "icon": "$(arrow-up)",
        "category": "JetTortoise"
      },
      {
        "command": "jettortoise.commitPanel.refresh",
        "title": "Refresh Changes",
        "icon": "$(refresh)",
        "category": "JetTortoise"
      },
      {
        "command": "jettortoise.commitPanel.commit",
        "title": "Commit",
        "icon": "$(check)",
        "category": "JetTortoise"
      },
      {
        "command": "jettortoise.commitPanel.commitAndPush",
        "title": "Commit and Push",
        "icon": "$(cloud-upload)",
        "category": "JetTortoise"
      },
      {
        "command": "jettortoise.commitPanel.shelve",
        "title": "Shelve Changes",
        "icon": "$(archive)",
        "category": "JetTortoise"
      },
      {
        "command": "jettortoise.commitPanel.unshelve",
        "title": "Unshelve Changes",
        "icon": "$(package)",
        "category": "JetTortoise"
      },
      {
        "command": "jettortoise.openPushPanel",
        "title": "Push...",
        "icon": "$(cloud-upload)",
        "category": "JetTortoise"
      },
      {
        "command": "jettortoise.editSource",
        "title": "(JetTortoise) Edit Source",
        "icon": "$(go-to-file)",
        "category": "JetTortoise"
      }
    ],
    "menus": {
      "view/title": [],
      "scm/title": [
        {
          "command": "jettortoise.openConflicts",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "jettortoise.openMergeEditorFromSCM",
          "when": "scmProvider == git && scmResourceGroup == merge",
          "group": "inline@10"
        }
      ],
      "editor/context": [
        {
          "command": "jettortoise.showFileHistory",
          "when": "editorTextFocus",
          "group": "git@1"
        },
        {
          "command": "jettortoise.editSource",
          "when": "isInDiffEditor && resourceScheme != file",
          "group": "git@2"
        }
      ],
      "explorer/context": [
        {
          "command": "jettortoise.showFileHistory",
          "when": "!explorerResourceIsFolder",
          "group": "git@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "jettortoise.openPushPanel",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      },
      {
        "command": "jettortoise.nextDiff",
        "key": "ctrl+f7",
        "mac": "cmd+f7",
        "when": "editorFocus"
      },
      {
        "command": "jettortoise.prevDiff",
        "key": "ctrl+shift+f7",
        "mac": "cmd+shift+f7",
        "when": "editorFocus"
      }
    ],
    "configuration": {
      "title": "JetTortoise",
      "properties": {
        "jettortoise.cvsPath": {
          "type": "string",
          "default": "cvs",
          "description": "Path to the CVS executable."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:webview": "cd webview && pnpm run watch",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "vsce:package": "pnpm run package && pnpm run build:web && vsce package --no-dependencies --out release/",
    "vsce:publish": "pnpm run package && pnpm run build:web && vsce publish --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "biome check src webview/src",
    "test": "vscode-test",
    "build:web": "cd webview && pnpm run build",
    "build": "pnpm run compile && pnpm run build:web",
    "dev:web": "cd webview && pnpm run dev",
    "test:headless": "node scripts/headless-check.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd",
  "dependencies": {
    "node-diff3": "^3.2.0"
  }
}
