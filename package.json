{
  "name": "jettortoise",
  "displayName": "JetTortoise",
  "publisher": "jetgit",
  "description": "%extension.description%",
  "version": "0.4.17",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jieyuexing/vscode-jettortoise-plugin"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "cvs",
    "version control",
    "commit",
    "shelf",
    "diff",
    "merge"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:jettortoise.workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "jettortoise.addRepository",
        "title": "%cmd.addRepository%",
        "category": "%category.jettortoise%",
        "icon": "$(add)"
      },
      {
        "command": "jettortoise.removeRepository",
        "title": "%cmd.removeRepository%",
        "category": "%category.jettortoise%",
        "icon": "$(remove)"
      },
      {
        "command": "jettortoise.scanRepositories",
        "title": "%cmd.scanRepositories%",
        "category": "%category.jettortoise%",
        "icon": "$(search)"
      },
      {
        "command": "jettortoise.updateRepository",
        "title": "%cmd.updateRepository%",
        "category": "%category.jettortoise%",
        "icon": "$(sync)"
      },
      {
        "command": "jettortoise.openHistory",
        "title": "%cmd.openHistory%",
        "category": "%category.jettortoise%",
        "icon": "$(history)"
      },
      {
        "command": "jettortoise.openCommit",
        "title": "%cmd.openCommit%",
        "category": "%category.jettortoise%",
        "icon": "$(check)"
      },
      {
        "command": "jettortoise.refresh",
        "title": "%cmd.refresh%",
        "category": "%category.jettortoise%",
        "icon": "$(refresh)"
      },
      {
        "command": "jettortoise.git.openPushPanel",
        "title": "%cmd.git.openPushPanel%",
        "category": "%category.jettortoise%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "jettortoise.git.openConflicts",
        "title": "%cmd.git.openConflicts%",
        "category": "%category.jettortoise%",
        "icon": "$(git-merge)"
      },
      {
        "command": "jettortoise.git.openMergeEditorFromSCM",
        "title": "%cmd.git.openMergeEditorFromSCM%",
        "category": "%category.jettortoise%",
        "icon": "$(git-merge)"
      },
      {
        "command": "jettortoise.git.nextDiff",
        "title": "%cmd.git.nextDiff%",
        "category": "%category.jettortoise%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "jettortoise.git.prevDiff",
        "title": "%cmd.git.prevDiff%",
        "category": "%category.jettortoise%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "jettortoise.git.editSource",
        "title": "%cmd.git.editSource%",
        "category": "%category.jettortoise%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "jettortoise.cvs.checkout",
        "title": "%cmd.cvs.checkout%",
        "category": "%category.jettortoise%",
        "icon": "$(repo-clone)"
      },
      {
        "command": "jettortoise.cvs.update",
        "title": "%cmd.cvs.update%",
        "category": "%category.jettortoise%",
        "icon": "$(sync)"
      },
      {
        "command": "jettortoise.cvs.cancel",
        "title": "%cmd.cvs.cancel%",
        "category": "%category.jettortoise%",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "jettortoise.git.openConflicts",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "jettortoise.git.openMergeEditorFromSCM",
          "when": "scmProvider == git && scmResourceGroup == merge",
          "group": "inline@10"
        }
      ],
      "editor/context": [
        {
          "command": "jettortoise.openHistory",
          "when": "resourceScheme == file",
          "group": "jettortoise@1"
        },
        {
          "command": "jettortoise.git.editSource",
          "when": "isInDiffEditor && resourceScheme == jettortoise && jettortoise.activeProvider == git",
          "group": "jettortoise@2"
        }
      ],
      "explorer/context": [
        {
          "command": "jettortoise.openHistory",
          "when": "!explorerResourceIsFolder && resourceScheme == file",
          "group": "jettortoise@1"
        }
      ],
      "commandPalette": [
        {
          "command": "jettortoise.git.openMergeEditorFromSCM",
          "when": "false"
        },
        {
          "command": "jettortoise.git.editSource",
          "when": "resourceScheme == jettortoise && jettortoise.activeProvider == git"
        },
        {
          "command": "jettortoise.git.nextDiff",
          "when": "isInDiffEditor && jettortoise.activeProvider == git"
        },
        {
          "command": "jettortoise.git.prevDiff",
          "when": "isInDiffEditor && jettortoise.activeProvider == git"
        }
      ]
    },
    "keybindings": [
      {
        "command": "jettortoise.git.openPushPanel",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "jettortoise.activeProvider == git && (activeWebviewPanelId == jettortoise.workspace || isInDiffEditor)"
      },
      {
        "command": "jettortoise.git.nextDiff",
        "key": "ctrl+f7",
        "mac": "cmd+f7",
        "when": "isInDiffEditor && jettortoise.activeProvider == git"
      },
      {
        "command": "jettortoise.git.prevDiff",
        "key": "ctrl+shift+f7",
        "mac": "cmd+shift+f7",
        "when": "isInDiffEditor && jettortoise.activeProvider == git"
      }
    ],
    "configuration": {
      "title": "JetTortoise",
      "properties": {
        "jettortoise.cvsPath": {
          "type": "string",
          "default": "cvs",
          "scope": "machine",
          "description": "%config.cvsPath%"
        },
        "jettortoise.autoDiscoverRepositories": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%config.autoDiscoverRepositories%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run l10n:prepare && pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "pnpm run l10n:prepare && npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:webview": "cd webview && pnpm run watch",
    "package": "pnpm run l10n:prepare && pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "vsce:package": "pnpm run package && pnpm run build:web && node scripts/package-vsix.cjs",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "biome check src webview/src",
    "test": "vscode-test",
    "build:web": "cd webview && pnpm run build",
    "build": "pnpm run compile && pnpm run build:web",
    "dev:web": "cd webview && pnpm run dev",
    "l10n:prepare": "node scripts/prepare-l10n.cjs",
    "check:l10n": "pnpm run l10n:prepare && node scripts/check-l10n.cjs",
    "test:headless": "node scripts/workbench-channel-check.cjs && node scripts/catalog-discovery-check.cjs && node scripts/catalog-registry-check.cjs && node scripts/catalog-update-check.cjs && node scripts/comparison-check.cjs && node scripts/git-nesting-check.cjs && node --test scripts/cvs-nesting-check.mjs && node scripts/nested-registry-check.cjs && node scripts/nested-watcher-check.cjs && node scripts/git-security-check.cjs && node scripts/check-message-contract.cjs && node scripts/message-security-check.cjs && node scripts/repository-isolation-check.cjs && node scripts/workspace-host-check.cjs && node scripts/history-panel-check.cjs && node scripts/host-ui-check.cjs && node scripts/check-vcs-ui.cjs && node scripts/cvs-core-check.cjs && node --test scripts/cvs-real-test.mjs && pnpm --dir webview test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd",
  "dependencies": {
    "node-diff3": "^3.2.0"
  },
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%workspace.trust%"
    },
    "virtualWorkspaces": false
  }
}
